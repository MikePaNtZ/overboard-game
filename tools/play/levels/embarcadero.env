# Level: embarcadero (Level 2, the SF Embarcadero cruise loop). Data: tools/levels/embarcadero/.
MAP=/Game/Maps/OB_Embarcadero
COURSE=${COURSE:-$HOME/projects/overboard-viz/out/carve-lab/data/courses/embarcadero}
# The spawn pose and the bounds come from $COURSE/metadata.json.
SPAWN_ARGS=
OBSTACLES=$COURSE/obstacles.csv
COURSE_ARG=-ObCourse=embarcadero
# Phase B traffic ($COURSE/objects.json, --objects) needs the controls objects build; not on the play pin yet.
